msgid ""
"Browser Picker\n"
"Choose where links and local files open.\n"
"\n"
"Usage:\n"
"  browser-picker\n"
"  browser-picker <http(s)-url>\n"
"  browser-picker --help\n"
"  browser-picker --version\n"
"\n"
"Options:\n"
"  -h, --help       Show this help\n"
"  -V, --version    Show version\n"
msgstr ""
"Browser Picker\n"
"Choose where links and local files open.\n"
"\n"
"Usage:\n"
"  browser-picker\n"
"  browser-picker <http(s)-url>\n"
"  browser-picker --help\n"
"  browser-picker --version\n"
"\n"
"Options:\n"
"  -h, --help       Show this help\n"
"  -V, --version    Show version\n"

